{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lca.tiangong.earth/release/release-candidate.v1.schema.json",
  "title": "Local Release Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "publicationAuthorized",
    "profile",
    "packagePlanSha256",
    "canonicalDatasetIndexSha256",
    "packages",
    "packageSetHash",
    "validation"
  ],
  "properties": {
    "schemaVersion": { "const": "tiangong.release.release-candidate.v1" },
    "status": { "const": "local_candidate" },
    "publicationAuthorized": { "const": false },
    "profile": { "const": "standalone-lifecyclemodel-result-full-closure.v1" },
    "packagePlanSha256": { "$ref": "#/$defs/hash" },
    "canonicalDatasetIndexSha256": { "$ref": "#/$defs/hash" },
    "packages": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "mediaType", "byteSize", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^packages/.+\\.zip$" },
          "mediaType": { "const": "application/zip" },
          "byteSize": { "type": "integer", "minimum": 1 },
          "sha256": { "$ref": "#/$defs/hash" }
        }
      }
    },
    "packageSetHash": { "$ref": "#/$defs/hash" },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delegatedTo", "outcome", "reportPath"],
      "properties": {
        "delegatedTo": { "const": "tidas-tools" },
        "outcome": { "const": "passed" },
        "reportPath": { "const": "tidas-release-report.json" }
      }
    }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
