{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lca.tiangong.earth/release/publication-scope-request.v1.schema.json",
  "title": "Publication Scope Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "candidate",
    "component",
    "include",
    "exclude",
    "targetId"
  ],
  "properties": {
    "schemaVersion": {
      "const": "tiangong.release.publication-scope-request.v1"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["releaseCandidateSha256", "packageSetHash"],
      "properties": {
        "releaseCandidateSha256": { "$ref": "#/$defs/hash" },
        "packageSetHash": { "$ref": "#/$defs/hash" }
      }
    },
    "component": { "enum": ["unit-process", "result", "both"] },
    "include": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/key" }
    },
    "exclude": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/key" }
    },
    "targetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*:[0-9a-f-]{36}@[0-9]{2}\\.[0-9]{2}\\.[0-9]{3}$"
    }
  }
}
