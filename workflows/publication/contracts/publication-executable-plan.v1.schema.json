{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lca.tiangong.earth/release/publication-executable-plan.v1.schema.json",
  "title": "Publication Executable Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "publicationAuthorized",
    "targetId",
    "publicationDraftPlanSha256",
    "payloadManifestSha256",
    "targetSnapshotSha256",
    "targetFingerprint",
    "publishedState",
    "operationCount",
    "operations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "tiangong.release.publication-executable-plan.v1"
    },
    "status": { "const": "ready_for_approval" },
    "publicationAuthorized": { "const": false },
    "targetId": { "type": "string", "minLength": 1 },
    "publicationDraftPlanSha256": { "$ref": "#/$defs/hash" },
    "payloadManifestSha256": { "$ref": "#/$defs/hash" },
    "targetSnapshotSha256": { "$ref": "#/$defs/hash" },
    "targetFingerprint": { "$ref": "#/$defs/hash" },
    "publishedState": { "$ref": "#/$defs/state" },
    "operationCount": { "type": "integer", "minimum": 1 },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/operation" }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic", "code"],
      "properties": {
        "semantic": { "const": "published" },
        "code": { "type": "integer", "minimum": 0 }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "table",
        "uuid",
        "version",
        "expectedCanonicalContentHash",
        "action"
      ],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "table": { "type": "string", "minLength": 1 },
        "uuid": { "type": "string", "format": "uuid" },
        "version": {
          "type": "string",
          "pattern": "^[0-9]{2}\\.[0-9]{2}\\.[0-9]{3}$"
        },
        "expectedCanonicalContentHash": { "$ref": "#/$defs/hash" },
        "action": {
          "enum": [
            "create_then_publish",
            "publish_existing",
            "already_published_noop"
          ]
        }
      }
    }
  }
}
