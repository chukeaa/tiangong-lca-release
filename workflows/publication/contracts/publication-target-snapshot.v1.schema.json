{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lca.tiangong.earth/release/publication-target-snapshot.v1.schema.json",
  "title": "Publication Target Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "targetId",
    "targetEndpointFingerprint",
    "actorUserId",
    "observedAt",
    "publishedState",
    "datasetCount",
    "rows",
    "fingerprint"
  ],
  "properties": {
    "schemaVersion": {
      "const": "tiangong.release.publication-target-snapshot.v1"
    },
    "targetId": { "type": "string", "minLength": 1 },
    "targetEndpointFingerprint": { "$ref": "#/$defs/hash" },
    "actorUserId": { "type": "string", "format": "uuid" },
    "observedAt": { "type": "string", "format": "date-time" },
    "publishedState": { "$ref": "#/$defs/state" },
    "datasetCount": { "type": "integer", "minimum": 1 },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/row" }
    },
    "fingerprint": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic", "code"],
      "properties": {
        "semantic": { "const": "published" },
        "code": { "type": "integer", "minimum": 0 }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "table",
        "uuid",
        "version",
        "expectedCanonicalContentHash",
        "classification",
        "stateCode",
        "ownerUserId",
        "observedContentHash",
        "blocker"
      ],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "table": { "type": "string", "minLength": 1 },
        "uuid": { "type": "string", "format": "uuid" },
        "version": {
          "type": "string",
          "pattern": "^[0-9]{2}\\.[0-9]{2}\\.[0-9]{3}$"
        },
        "expectedCanonicalContentHash": { "$ref": "#/$defs/hash" },
        "classification": {
          "enum": [
            "absent",
            "matching_unpublished",
            "matching_published",
            "matching_not_publishable",
            "content_conflict"
          ]
        },
        "stateCode": { "type": ["integer", "null"] },
        "ownerUserId": { "type": ["string", "null"] },
        "observedContentHash": {
          "oneOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }]
        },
        "blocker": { "type": ["object", "null"] }
      }
    }
  }
}
