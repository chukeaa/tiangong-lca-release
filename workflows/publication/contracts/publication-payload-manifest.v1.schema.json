{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lca.tiangong.earth/release/publication-payload-manifest.v1.schema.json",
  "title": "Publication Payload Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "candidate",
    "publicationDraftPlanSha256",
    "scopeResolutionSha256",
    "datasetCount",
    "datasetSetHash",
    "datasets"
  ],
  "properties": {
    "schemaVersion": {
      "const": "tiangong.release.publication-payload-manifest.v1"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["releaseCandidateSha256", "packageSetHash"],
      "properties": {
        "releaseCandidateSha256": { "$ref": "#/$defs/hash" },
        "packageSetHash": { "$ref": "#/$defs/hash" }
      }
    },
    "publicationDraftPlanSha256": { "$ref": "#/$defs/hash" },
    "scopeResolutionSha256": { "$ref": "#/$defs/hash" },
    "datasetCount": { "type": "integer", "minimum": 1 },
    "datasetSetHash": { "$ref": "#/$defs/hash" },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/dataset" }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "location", "role"],
      "properties": {
        "target": { "type": "string", "minLength": 1 },
        "location": { "type": "string" },
        "role": { "const": "closure_dependency" }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "datasetType",
        "role",
        "uuid",
        "version",
        "path",
        "sha256",
        "canonicalContentHash",
        "references",
        "components",
        "table",
        "payloadPath",
        "sourcePackage",
        "modelId"
      ],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "datasetType": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "uuid": { "type": "string", "format": "uuid" },
        "version": {
          "type": "string",
          "pattern": "^[0-9]{2}\\.[0-9]{2}\\.[0-9]{3}$"
        },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/hash" },
        "canonicalContentHash": { "$ref": "#/$defs/hash" },
        "references": {
          "type": "array",
          "items": { "$ref": "#/$defs/reference" }
        },
        "components": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["unit_process", "result"] }
        },
        "table": {
          "enum": [
            "contacts",
            "sources",
            "unitgroups",
            "flowproperties",
            "flows",
            "processes",
            "lifecyclemodels"
          ]
        },
        "payloadPath": { "type": "string", "pattern": "^datasets/" },
        "sourcePackage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "sha256": { "$ref": "#/$defs/hash" }
          }
        },
        "modelId": {
          "oneOf": [{ "type": "string", "format": "uuid" }, { "type": "null" }]
        }
      }
    }
  }
}
