{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lca.tiangong.earth/release/transformation-handoff.v0.schema.json",
  "title": "Dataset Transformation Handoff v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "parentCandidate",
    "transformationFrozenSpecSha256",
    "transformationExecutionReceiptSha256",
    "transformedDatasets",
    "inheritedData",
    "nextWorkflow",
    "reason",
    "finalTarget"
  ],
  "properties": {
    "schemaVersion": { "const": "tiangong.release.transformation-handoff.v0" },
    "status": { "const": "ready_for_calculation" },
    "parentCandidate": { "type": "object" },
    "transformationFrozenSpecSha256": { "$ref": "#/$defs/hash" },
    "transformationExecutionReceiptSha256": { "$ref": "#/$defs/hash" },
    "transformedDatasets": { "type": "array", "minItems": 1 },
    "inheritedData": { "type": "object" },
    "nextWorkflow": { "const": "calculation" },
    "reason": { "type": "string", "minLength": 1 },
    "finalTarget": { "const": "new-release-candidate" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
