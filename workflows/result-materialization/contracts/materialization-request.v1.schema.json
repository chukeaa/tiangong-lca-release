{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lca.tiangong.earth/release/materialization-request.v1.schema.json",
  "title": "Result Materialization Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scope",
    "outputType",
    "resultProcessLayer",
    "modelProfile"
  ],
  "properties": {
    "schemaVersion": {
      "const": "tiangong.release.materialization-request.v1"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "requestedSelectors", "processes"],
      "properties": {
        "mode": { "enum": ["selected", "all_eligible"] },
        "requestedSelectors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "processes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version"],
            "properties": {
              "id": { "type": "string", "format": "uuid" },
              "version": {
                "type": "string",
                "pattern": "^[0-9]{2}\\.[0-9]{2}\\.[0-9]{3}$"
              }
            }
          }
        }
      }
    },
    "outputType": { "enum": ["result-process", "lifecycle-model"] },
    "resultProcessLayer": {
      "description": "Content layer of every Result Process generated for this request. LifecycleModel itself does not contain LCI or LCIA results.",
      "enum": ["lci", "lci-lcia"]
    },
    "modelProfile": { "type": ["string", "null"] }
  }
}
