{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lca.tiangong.earth/release/dataset-descriptor.v1.schema.json",
  "title": "Materialized Dataset Descriptor",
  "type": "object",
  "required": [
    "schemaVersion",
    "datasetType",
    "role",
    "uuid",
    "version",
    "profile",
    "versionSignificantHash",
    "semanticHash",
    "canonicalContentHash",
    "path"
  ],
  "properties": {
    "schemaVersion": { "const": "tiangong.release.dataset-descriptor.v1" },
    "datasetType": { "enum": ["process", "lifecyclemodel"] },
    "role": { "enum": ["result_process", "lifecycle_model"] },
    "uuid": { "type": "string", "format": "uuid" },
    "version": {
      "type": "string",
      "pattern": "^[0-9]{2}\\.[0-9]{2}\\.[0-9]{3}$"
    },
    "profile": { "type": "string", "minLength": 1 },
    "versionSignificantHash": { "$ref": "#/$defs/hash" },
    "semanticHash": { "$ref": "#/$defs/hash" },
    "canonicalContentHash": { "$ref": "#/$defs/hash" },
    "path": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
