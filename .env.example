# Password-equivalent secret: inject locally or through a protected environment.
TIANGONG_LCA_API_BASE_URL=
TIANGONG_LCA_API_KEY=
TIANGONG_LCA_SUPABASE_PUBLISHABLE_KEY=
TIANGONG_LCA_ACCESS_TOKEN=

# Optional exact override. Defaults to
# ${TIANGONG_LCA_API_BASE_URL}/functions/v1/app_data_product_commands.
TIANGONG_LCA_DATA_PRODUCT_COMMAND_URL=

# Optional executable overrides for local integration and pinned tool builds.
TIANGONG_LCA_CLI_EXECUTABLE=tiangong-lca
TIANGONG_TIDAS_EXECUTABLE=tidas
