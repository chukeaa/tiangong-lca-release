{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lca.tiangong.earth/schemas/calculation-bundle.v1.json",
  "title": "TianGong Calculation Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "calculationContractVersion",
    "calculationId",
    "bundleContentHash",
    "scope",
    "snapshot",
    "solver",
    "methodSet",
    "artifacts",
    "calculationEvidence",
    "hashes"
  ],
  "properties": {
    "schemaVersion": { "const": "tiangong.calculation-bundle.v1" },
    "calculationContractVersion": { "type": "string", "minLength": 1 },
    "calculationId": { "$ref": "#/$defs/uuid" },
    "createdAt": { "type": "string", "format": "date-time" },
    "bundleContentHash": { "$ref": "#/$defs/sha256" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverageMode", "processCount", "selectionManifestHash"],
      "properties": {
        "coverageMode": { "enum": ["subset", "global_eligible"] },
        "processCount": { "$ref": "#/$defs/nonNegativeInteger" },
        "selectionManifestHash": { "$ref": "#/$defs/sha256" }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256", "processCount", "flowCount", "impactCount"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "processCount": { "$ref": "#/$defs/nonNegativeInteger" },
        "flowCount": { "$ref": "#/$defs/nonNegativeInteger" },
        "impactCount": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "solver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engineVersion",
        "numericalPolicy",
        "providerPolicy",
        "allocationPolicy",
        "zeroPolicy"
      ],
      "properties": {
        "engineVersion": { "type": "string", "minLength": 1 },
        "numericalPolicy": { "$ref": "#/$defs/nonEmptyObject" },
        "providerPolicy": { "$ref": "#/$defs/nonEmptyObject" },
        "allocationPolicy": { "$ref": "#/$defs/nonEmptyObject" },
        "zeroPolicy": { "$ref": "#/$defs/nonEmptyObject" }
      }
    },
    "methodSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "bundleVersion",
        "methodCount",
        "rawManifestSha256",
        "sourceSnapshotSha256",
        "methodManifestSha256",
        "methodIdentityManifestSha256",
        "factorManifestSha256"
      ],
      "properties": {
        "schemaVersion": { "const": "lcia.static_cache_bundle.v1" },
        "bundleVersion": { "const": "1.2.4" },
        "methodCount": { "const": 25 },
        "rawManifestSha256": { "$ref": "#/$defs/sha256" },
        "sourceSnapshotSha256": { "$ref": "#/$defs/sha256" },
        "methodManifestSha256": { "$ref": "#/$defs/sha256" },
        "methodIdentityManifestSha256": { "$ref": "#/$defs/sha256" },
        "factorManifestSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 7,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "calculationEvidence": { "$ref": "#/$defs/nonEmptyObject" },
    "hashes": { "$ref": "#/$defs/nonEmptyObject" }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]{2}\\.[0-9]{2}\\.[0-9]{3}$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nonNegativeInteger": { "type": "integer", "minimum": 0 },
    "nonEmptyObject": { "type": "object", "minProperties": 1 },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "path",
        "schemaVersion",
        "mediaType",
        "sha256",
        "byteSize",
        "recordCount"
      ],
      "properties": {
        "kind": {
          "enum": [
            "process_axis",
            "inventory_axis",
            "technosphere_edges",
            "biosphere_edges",
            "lci",
            "lcia",
            "coverage",
            "csv",
            "json",
            "hdf5"
          ]
        },
        "path": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*$" },
        "schemaVersion": { "type": "string", "minLength": 1 },
        "mediaType": { "type": "string", "minLength": 1 },
        "compression": { "enum": ["gzip", "none"] },
        "sha256": { "$ref": "#/$defs/sha256" },
        "uncompressedSha256": { "$ref": "#/$defs/sha256" },
        "byteSize": { "$ref": "#/$defs/nonNegativeInteger" },
        "uncompressedByteSize": { "$ref": "#/$defs/nonNegativeInteger" },
        "recordCount": { "$ref": "#/$defs/nonNegativeInteger" },
        "firstProcessIndex": { "$ref": "#/$defs/nonNegativeInteger" },
        "lastProcessIndex": { "$ref": "#/$defs/nonNegativeInteger" },
        "derived": { "type": "boolean", "default": false }
      }
    },
    "globalReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "version": { "$ref": "#/$defs/version" }
      }
    },
    "quantitativeReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exchangeInternalId",
        "flow",
        "direction",
        "referenceUnit",
        "meanAmount"
      ],
      "properties": {
        "exchangeInternalId": { "type": "string", "minLength": 1 },
        "flow": { "$ref": "#/$defs/globalReference" },
        "direction": { "const": "Output" },
        "referenceUnit": { "type": "string", "minLength": 1 },
        "meanAmount": { "type": "number", "not": { "const": 0 } }
      }
    },
    "processRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["processIndex", "rootProcess", "quantitativeReference"],
      "properties": {
        "processIndex": { "$ref": "#/$defs/nonNegativeInteger" },
        "rootProcess": { "$ref": "#/$defs/globalReference" },
        "quantitativeReference": { "$ref": "#/$defs/quantitativeReference" }
      }
    },
    "technosphereEdgeRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumerProcessIndex",
        "consumerInputExchangeInternalId",
        "providerProcessIndex",
        "providerOutputExchangeInternalId",
        "providerWeight",
        "normalizedAmount",
        "flow"
      ],
      "properties": {
        "consumerProcessIndex": { "$ref": "#/$defs/nonNegativeInteger" },
        "consumerInputExchangeInternalId": { "type": "string", "minLength": 1 },
        "providerProcessIndex": { "$ref": "#/$defs/nonNegativeInteger" },
        "providerOutputExchangeInternalId": {
          "type": "string",
          "minLength": 1
        },
        "providerWeight": { "type": "number" },
        "normalizedAmount": { "type": "number" },
        "flow": { "$ref": "#/$defs/globalReference" },
        "location": { "type": ["string", "null"] }
      }
    },
    "inventoryExchange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flow", "direction", "unit", "meanAmount"],
      "properties": {
        "exchangeInternalId": { "type": "string", "minLength": 1 },
        "flow": { "$ref": "#/$defs/globalReference" },
        "direction": { "enum": ["Input", "Output"] },
        "unit": { "type": "string", "minLength": 1 },
        "location": { "type": ["string", "null"] },
        "meanAmount": { "type": "number" },
        "allocationTargetInternalId": { "type": "string", "minLength": 1 },
        "allocationFraction": { "type": "number" }
      }
    }
  }
}
