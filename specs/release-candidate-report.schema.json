{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lca.tiangong.earth/schemas/release-candidate-report.v1.json",
  "title": "TianGong Release Candidate Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "complete",
    "truncated",
    "releaseRunId",
    "runDirectory",
    "releaseStatus",
    "target",
    "calculationBundle",
    "stageCounts",
    "publishPlan",
    "packages",
    "validation",
    "blockers",
    "warnings",
    "artifactPaths",
    "nextCommands"
  ],
  "properties": {
    "schemaVersion": { "const": "tiangong.release-candidate-report.v1" },
    "status": { "const": "completed" },
    "complete": { "type": "boolean" },
    "truncated": { "type": "boolean" },
    "releaseRunId": { "type": "string", "format": "uuid" },
    "runDirectory": { "type": "string", "minLength": 1 },
    "releaseStatus": { "type": "string", "minLength": 1 },
    "target": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/target" }]
    },
    "calculationBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestPath", "bundleContentHash"],
      "properties": {
        "manifestPath": { "type": "string", "minLength": 1 },
        "bundleContentHash": { "$ref": "#/$defs/sha256" }
      }
    },
    "stageCounts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "publishPlan": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/publishPlan" }]
    },
    "packages": {
      "type": "array",
      "items": { "$ref": "#/$defs/package" }
    },
    "validation": { "type": ["object", "null"] },
    "blockers": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "warnings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "artifactPaths": { "type": "array", "items": { "type": "string" } },
    "nextCommands": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetId", "targetFingerprint"],
      "properties": {
        "targetId": { "type": "string", "minLength": 1 },
        "targetFingerprint": { "$ref": "#/$defs/sha256" }
      }
    },
    "publishPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planHash", "releaseVersion", "path", "sha256"],
      "properties": {
        "planHash": { "$ref": "#/$defs/sha256" },
        "releaseVersion": { "type": "string" },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "format", "sha256", "byteSize", "path"],
      "properties": {
        "profileId": { "type": "string", "minLength": 1 },
        "format": { "enum": ["tidas", "ilcd"] },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byteSize": { "type": "integer", "minimum": 0 },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "subject": { "type": "string", "minLength": 1 }
      }
    }
  }
}
