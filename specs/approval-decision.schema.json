{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lca.tiangong.earth/schemas/release-approval-decision.v1.json",
  "title": "TianGong Release Approval Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "releaseRunId", "publishPlanHash", "decision"],
  "properties": {
    "schemaVersion": { "const": "tiangong.release.approval-decision.v1" },
    "releaseRunId": { "type": "string", "format": "uuid" },
    "publishPlanHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "decision": { "const": "approve" },
    "reason": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "expiresAt": { "type": "string", "format": "date-time" }
  }
}
